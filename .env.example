# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must never be committed.
#
# On a hosting platform (Vercel, Render, Railway…) .env.local is NOT deployed —
# every variable below must be re-entered in that platform's dashboard.
# See DEPLOYMENT.md for the full production checklist.

# Server-side SMTP credentials for OTP email (e.g. a Gmail app password)
EMAIL_USER=your-smtp-username@gmail.com
EMAIL_PASS=your-smtp-app-password

# App — the public URL of the site. Must be the real domain in production.
NEXT_PUBLIC_URL=http://localhost:3000

# MongoDB Atlas connection string, from Atlas → Connect → Drivers.
# Any password special characters must be percent-encoded (@ becomes %40).
DB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# Which database inside the cluster to use. Set this to a different value in
# production (e.g. panchayatx_prod) so local testing cannot touch live data.
# Defaults to "panchayatX" when unset.
DB_NAME=panchayatX

# Secret used to sign the login session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a DIFFERENT value in production. Changing it logs everybody out.
SESSION_SECRET=your-long-random-session-secret

# EdgeStore file storage (images, videos, documents)
EDGE_STORE_ACCESS_KEY=your-edgestore-access-key
EDGE_STORE_SECRET_KEY=your-edgestore-secret-key
